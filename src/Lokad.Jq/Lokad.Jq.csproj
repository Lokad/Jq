<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Lokad.Jq</PackageId>
    <Title>Lokad.Jq</Title>
    <Description>Embeddable jq runtime for .NET with host-mediated IO. See docs/COMPATIBILITY_MATRIX.md for the jq 1.8.2 conformance inventory; compatibility is incomplete.</Description>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Version>0.1.0-preview.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See CHANGELOG.md for release details.</PackageReleaseNotes>
    <PackageTags>jq;json;scripting;embedding</PackageTags>
    <PackageProjectUrl>https://github.com/lokad/Jq</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lokad/Jq</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>../../artifacts/nuget/</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE.txt;../../README.md;../../CHANGELOG.md;../../icon.png" Pack="true" PackagePath="/" Visible="false" />
    <PackageReference Include="Lokad.Utf8Regex.Pcre2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <Target Name="EnforceReleasePackageConfiguration" BeforeTargets="GenerateNuspec"
          Condition="'$(Configuration)' != 'Release' and '$(AllowNonReleasePackage)' != 'true'">
    <Error Text="NuGet packages must be produced with -c Release. Pass /p:AllowNonReleasePackage=true only for troubleshooting." />
  </Target>
</Project>
